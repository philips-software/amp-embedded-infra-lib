sequenceDiagram
    title BLE Central with BinaryPipe Data Transfer

    participant Product as Product
    participant CN as CN<br>[implements GapCentral,<br>BinaryPipeSend,<br>BinaryPipeReceive]
    participant Peripheral as BLE Peripheral

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 1. Connect
        Product->>CN: GapCentral.Connect(<br>addressWithType={address=C4:AB:12:34:56:78, addressType=randomAddress},<br>initiatingTimeoutInMs=5000)
        CN-->>Product: GapCentralResponse.CurrentState(initiating)
        CN->>Peripheral: BLE connection request
        Peripheral-->>CN: Connection accepted
        CN-->>Product: GapCentralResponse.CurrentState(connected)
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 2. BinaryPipe becomes available
        CN-->>Product: BinaryPipeConnection.Available()

        Note over Product: BinaryPipe is ready.<br>Send and Receive operations can now be used.
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 3. Send data to peripheral
        Product->>CN: BinaryPipeSend.SendData(subchannel=1, data=256 bytes)
        Note right of Product: Wait for SendCompleted before next send
        CN-->>Product: BinaryPipeSendResponse.SendCompleted()

        Product->>CN: BinaryPipeSend.SendData(subchannel=1, data=256 bytes)
        CN-->>Product: BinaryPipeSendResponse.SendCompleted()
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 4. Receive data from peripheral
        Product->>CN: BinaryPipeReceive.ReceiveData(subchannel=1, report=true)
        Peripheral->>CN: Data from peripheral
        CN-->>Product: BinaryPipeReceiveResponse.DataReceived(<br>subchannel=1, data=256 bytes)
        Peripheral->>CN: Data from peripheral
        CN-->>Product: BinaryPipeReceiveResponse.DataReceived(<br>subchannel=1, data=256 bytes)
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 5. Peripheral disconnects
        Peripheral--xCN: Peer disconnects
        CN-->>Product: BinaryPipeConnection.Unavailable()
        CN-->>Product: GapCentralResponse.CurrentState(standby)

        Note over Product: No further BinaryPipe operations until<br>reconnected and Available() is received again.
    end
