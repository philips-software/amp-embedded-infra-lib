sequenceDiagram
    participant Product as Product
    participant CN as CN Central<br>[implements GapCentral]
    participant Peripheral as BLE Peripheral

    rect rgb(230, 230, 240)
        note over Product, Peripheral: Connect without pairing
        Product->>CN: GapCentral.Connect(<br>addressWithType={address=C4:AB:12:34:56:78, addressType=randomAddress},<br>initiatingTimeoutInMs=5000)
        CN-->>Product: GapCentralResponse.CurrentState(initiating)
        CN-->>Product: GapCentralResponse.CurrentState(connected)
    end

    alt Product forgets PairAndBond (unencrypted link)
        rect rgb(230, 230, 240)
            note over Product, Peripheral: Attempt Condor initialization
            Product->>Peripheral: Condor request (unencrypted)
            Note over Product, Peripheral: Condor requires an encrypted link.<br>Peer will not respond or will reject.
            Note over Product: Result: no useful data exchanged.
        end
    else Product calls PairAndBond first
        rect rgb(230, 230, 240)
            note over Product, Peripheral: Secure the link before using Condor
            Product->>CN: GapCentral.PairAndBond()
            CN-->>Product: GapCentralResponse.NumberOfBondsChanged(1)
            CN-->>Product: GapCentralResponse.PairingResult(pairedSuccessfully=true)
            Product->>Peripheral: Condor request (encrypted)
            Peripheral-->>Product: Condor response
        end
    end
