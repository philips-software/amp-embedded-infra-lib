sequenceDiagram
    participant App as App<br>[implements GapCentralResponse]
    participant Node as Node<br>[implements GapCentral]

    App->>Node: GapCentral.PairAndBond()

    alt Successful pairing with new bond
        Node-->>App: GapCentralResponse.AuthenticationRequired(<br>isNumericComparison=true, passkey=485923)
        Note right of App: User responds via NumericComparisonConfirm / PasskeyEntry
        Node-->>App: GapCentralResponse.NumberOfBondsChanged(1)
        Node-->>App: GapCentralResponse.PairingResult(pairedSuccessfully=true)
    else Successful re-encryption with existing bond
        Node-->>App: GapCentralResponse.NumberOfBondsChanged(N)
        Node-->>App: GapCentralResponse.PairingResult(pairedSuccessfully=true)
        Note over App: NumberOfBondsChanged fires as a bond-aging (LRU) signal.<br>The reported N equals the current bond count and is unchanged.
    else Pairing failure
        Node-->>App: GapCentralResponse.AuthenticationRequired(<br>isNumericComparison=true, passkey=485923)
        Node-->>App: GapCentralResponse.PairingResult(<br>pairedSuccessfully=false, reason=numericComparisonFailed)
    else Peer-initiated disconnect during pairing
        Node-->>App: GapCentralResponse.PairingResult(<br>pairedSuccessfully=false, reason=unknown)
        Node-->>App: GapCentralResponse.CurrentState(standby)
    end
