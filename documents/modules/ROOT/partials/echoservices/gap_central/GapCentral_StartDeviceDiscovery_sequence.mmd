sequenceDiagram
    participant App as App<br>[implements GapCentralResponse]
    participant Node as Node<br>[implements GapCentral]
    App->>Node: GapCentral.StartDeviceDiscovery()
    Node-->>App: GapCentralResponse.CurrentState(scanning)
    loop For each matching advertisement (continuous until Standby)
        Node-->>App: GapCentralResponse.DeviceDiscovered(<br>addressWithType={address=C4:AB:12:34:56:78, addressType=randomAddress},<br>rssi=-38)
    end
