sequenceDiagram
    participant Product as Product<br>[implements GapPeripheralResponse]
    participant CN as CN<br>[implements GapPeripheral]
    participant Central as BLE Central

    rect rgb(230, 230, 240)
        note over Product, Central: Pairing disallowed - no existing bond
        Product->>CN: GapPeripheral.SetAllowPairing(false)
        Product->>CN: GapPeripheral.Advertise(type=advInd, advertisingInterval=160)
        CN-->>Product: GapPeripheralResponse.CurrentState(advertising)

        Central->>CN: BLE connection request
        CN--xCentral: Connection rejected

        Note over Product: No bond exists and pairing is disallowed.<br>Central cannot connect.
    end

    rect rgb(230, 230, 240)
        note over Product, Central: Pairing disallowed - existing bond allows re-encryption
        Product->>CN: GapPeripheral.SetAllowPairing(false)
        Product->>CN: GapPeripheral.Advertise(type=advInd, advertisingInterval=160)
        CN-->>Product: GapPeripheralResponse.CurrentState(advertising)

        Central->>CN: BLE connection request (bonded central)
        CN-->>Product: GapPeripheralResponse.CurrentState(connected)

        Note over Product: Bonded central can still connect and re-encrypt.<br>Only new pairing is blocked.
    end
