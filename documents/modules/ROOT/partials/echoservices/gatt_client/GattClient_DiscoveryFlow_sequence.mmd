sequenceDiagram
    title GATT Discovery Flow

    participant Product as Product<br>[implements GattClientResponse]
    participant CN as CN<br>[implements GattClient]
    participant Peripheral as BLE Peripheral

    rect rgb(230, 230, 240)
        note over Product, Peripheral: Service Discovery
        Product->>CN: StartServiceDiscovery()
        loop For each service found
            Peripheral-->>CN: Service
            CN-->>Product: ServiceDiscovered(<br>uuid=0x180F, handles={startHandle=0x0020, endHandle=0x0028})
        end
        CN-->>Product: ServiceDiscoveryComplete()
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: Characteristic Discovery
        loop For each discovered service
            Product->>CN: StartCharacteristicDiscovery(<br>startHandle=service.handles.startHandle, endHandle=service.handles.endHandle)
            loop For each characteristic
                Peripheral-->>CN: Characteristic
                CN-->>Product: CharacteristicDiscovered(<br>uuid=0x2A19, handle=0x0024,<br>valueHandle=0x0025, properties=0x12)
            end
            CN-->>Product: CharacteristicDiscoveryComplete()
        end
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: Descriptor Discovery
        loop For each characteristic
            note left of Product: Descriptor range:<br>startHandle = characteristic.valueHandle + 1<br>endHandle = nextCharacteristic.handle - 1<br>(or service.handles.endHandle for the last characteristic)
            Product->>CN: StartDescriptorDiscovery(<br>startHandle=0x0026, endHandle=0x0028)
            loop For each descriptor
                Peripheral-->>CN: Descriptor
                CN-->>Product: DescriptorDiscovered(<br>uuid=0x2902, handle=0x0026)
            end
            CN-->>Product: DescriptorDiscoveryComplete()
        end
    end
