sequenceDiagram
    title GATT Indication Flow: Enable, Receive, Acknowledge

    participant Product as Product<br>[implements GattClientResponse]
    participant CN as CN<br>[implements GattClient]
    participant Peripheral as BLE Peripheral

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 1. Discover CCCD for target characteristic
        Product->>CN: GattClient.StartDescriptorDiscovery(<br>startHandle=0x0026, endHandle=0x0028)
        CN-->>Product: GattClientResponse.DescriptorDiscovered(<br>uuid=0x2902, handle=0x0026)
        CN-->>Product: GattClientResponse.DescriptorDiscoveryComplete()
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 2. Enable indications (not notifications)
        Product->>CN: GattClient.WriteDescriptor(<br>handle=0x0026, data=0x0200)
        CN-->>Product: GattClientResponse.OperationComplete(success)

        note over Product: 0x0100 = notifications (no ack required)<br>0x0200 = indications (ack required)<br>0x0300 = both enabled
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 3. Receive and acknowledge indications
        Peripheral->>CN: Indication on characteristic
        CN-->>Product: GattClientResponse.IndicationReceived(<br>handle=0x0025, data=0x64)
        Product->>CN: GattClient.IndicationDone()
        Note right of Product: Must call IndicationDone for every IndicationReceived.<br>Peripheral will not send the next indication until acknowledged.

        Peripheral->>CN: Indication on characteristic
        CN-->>Product: GattClientResponse.IndicationReceived(<br>handle=0x0025, data=0x65)
        Product->>CN: GattClient.IndicationDone()
    end

    rect rgb(230, 230, 240)
        note over Product, Peripheral: 4. Disable indications
        Product->>CN: GattClient.WriteDescriptor(<br>handle=0x0026, data=0x0000)
        CN-->>Product: GattClientResponse.OperationComplete(success)
    end
